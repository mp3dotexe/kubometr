# Нужен хотя бы один мессенджер: BOT_TOKEN (Telegram) и/или MAX_TOKEN (MAX).

# --- Telegram ---
BOT_TOKEN=your_telegram_bot_token_here
# Необязательный прокси для Telegram, например Tor: socks5://127.0.0.1:9050
PROXY_URL=

# --- MAX Messenger ---
MAX_TOKEN=
# Обязателен, если задан MAX_TOKEN. Любая длинная случайная строка.
MAX_WEBHOOK_SECRET=
# Публичный HTTPS-адрес вебхука. Если задан, бот сам подписывается при старте.
MAX_WEBHOOK_URL=https://example.com/max/webhook
MAX_PORT=8080

# --- AI (любой OpenAI-совместимый API, по умолчанию OpenRouter) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
AI_BASE_URL=https://openrouter.ai/api/v1
# Одна модель или несколько через запятую: если модель недоступна
# (лимит, перегрузка, снята с тарифа), запрос уходит к следующей.
AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free,qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free

AI_TIMEOUT=30s
# Сколько ждать одну модель, прежде чем перейти к следующей (кроме последней).
AI_MODEL_TIMEOUT=20s
AI_RATE_LIMIT=3s
MAX_PROMPT_LENGTH=2000
MAX_CONCURRENT_AI=4

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=kubometr_db
