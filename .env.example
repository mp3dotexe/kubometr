# Нужен хотя бы один мессенджер: BOT_TOKEN (Telegram) и/или MAX_TOKEN (MAX).

# --- Telegram ---
BOT_TOKEN=your_telegram_bot_token_here
# Необязательный прокси для Telegram, например Tor: socks5://127.0.0.1:9050
PROXY_URL=

# --- MAX Messenger ---
MAX_TOKEN=
# Обязателен, если задан MAX_TOKEN. Любая длинная случайная строка.
MAX_WEBHOOK_SECRET=
# Публичный HTTPS-адрес вебхука. Если задан, бот сам подписывается при старте.
MAX_WEBHOOK_URL=https://example.com/max/webhook
MAX_PORT=8080

# --- AI (любой OpenAI-совместимый API, по умолчанию OpenRouter) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-oss-20b:free

AI_TIMEOUT=30s
AI_RATE_LIMIT=3s
MAX_PROMPT_LENGTH=2000
MAX_CONCURRENT_AI=4

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=kubometr_db
